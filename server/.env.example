# من لوحة Metered: https://dashboard.metered.ca
# اسم التطبيق يظهر في الصفحة الرئيسية للوحة (مثال: myapp  ← myapp.metered.live)
METERED_APP_NAME=
# المفتاح السري: Dashboard ← Developers ← Secret Key (لا تضعه في الواجهة الأمامية أبداً)
METERED_SECRET_KEY=

PORT=8787
# أقصى عدد مشاركين في الغرفة الصوتية (حسب خطتك في Metered)
MAX_AUDIO_PARTICIPANTS=100
