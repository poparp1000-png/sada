# من لوحة Metered: https://dashboard.metered.ca
METERED_APP_NAME=
METERED_SECRET_KEY=

# التخزين الدائم للحسابات والأصدقاء (Postgres). على Railway يُضبط بالمرجع: ${{Postgres.DATABASE_URL}}
# بدونه تُحفظ البيانات في ملف محلي يُمسح عند كل نشر جديد.
DATABASE_URL=

# اختياري: مفتاح توقيع جلسات الدخول. إن تُرك فارغاً يُشتق من METERED_SECRET_KEY.
AUTH_SECRET=

PORT=8787
MAX_AUDIO_PARTICIPANTS=100
